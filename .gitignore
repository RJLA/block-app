# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Tests ----------------------------------------------------------------
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# --- PyInstaller (build.bat) ----------------------------------------------
build/
dist/
*.spec
*.manifest

# --- Inno Setup (installer.iss) -------------------------------------------
# The finished installer IS tracked, so it can be downloaded straight onto a
# target PC. Everything else Inno writes is build scratch.
Output/*
!Output/BlockGuardSetup.exe
*.iss.bak

# --- Local runtime artifacts ----------------------------------------------
# The live config and log belong in %ProgramData%\BlockGuard, never here.
blocklist.json
guard.log

# --- Editors / OS ---------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
